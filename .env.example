# Copia este archivo como ".env" y llena los valores reales.

# URL base del backend
VITE_API_URL=http://localhost:8000/api

# Llave PÚBLICA de Wompi (no es secreta, está diseñada para ir en el
# frontend) — se consigue en el dashboard de Wompi (comercios.wompi.co).
# Usa la de "modo pruebas" (pub_test_...) mientras prueban, y cambia a la de
# "modo producción" (pub_prod_...) para el lanzamiento — sin tocar código.
VITE_WOMPI_PUBLIC_KEY=pub_test_6jhHtUtNNHZ6HkikZE9139oIbmtsVXPk

# Client ID de Google para "Acceder con Google" (público). Opcional: si no se
# define, se usa el que viene en el código. Debe ser el mismo que GOOGLE_CLIENT_ID
# del backend.
VITE_GOOGLE_CLIENT_ID=488911224398-v38b4s2o8317bu2j6jkia4e2i8vqh6i5.apps.googleusercontent.com
